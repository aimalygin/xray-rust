+
+    #[test]
+    fn noise_debug_and_key_updates_preserve_redacted_ownership() {
+        let private = x25519::StaticSecret::from([0x42; 32]);
+        let peer_private = x25519::StaticSecret::from([0x53; 32]);
+        let mut params = NoiseParams::new(
+            private.clone(),
+            x25519::PublicKey::from(&private),
+            x25519::PublicKey::from(&peer_private),
+            Some(PresharedKey::new(&[0xa5; 32])),
+        );
+        let snapshot = params.preshared_key.clone().unwrap();
+        let debug = format!("{params:?}");
+        assert!(debug.contains("PresharedKey(<redacted>)"));
+        assert!(!debug.contains("165, 165"));
+        params.set_preshared_key(Some(PresharedKey::new(&[0x64; 32])));
+        assert_eq!(
+            params.preshared_key.as_ref().unwrap().as_bytes(),
+            &[0x64; 32]
+        );
+        assert_eq!(snapshot.as_bytes(), &[0xa5; 32]);
+        params.set_preshared_key(None);
+        assert!(params.preshared_key.is_none());
+        assert!(!format!("{params:?}").contains("100, 100"));
+    }
+}
