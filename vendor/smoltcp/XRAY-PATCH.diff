+    fn receive_budget_rounding_retains_credit_within_physical_capacity() {
+        for queued in [false, true] {
+            let mut s = socket_established_with_buffer_sizes(64, 128 * 1024);
+            let start = REMOTE_SEQ + 1;
+            let previous_end = start + 128 * 1024;
+            s.remote_win_shift = 4;
+            s.receive_window_end = Some(previous_end);
+            s.receive_window_limit = Some(128 * 1024);
+            s.set_receive_window_limit(64 * 1024);
+            if queued {
+                s.rx_buffer.enqueue_slice(&[0; 1452]);
+            } else {
+                s.remote_seq_no = start + 1452;
+            }
+            let advertised = (s.scaled_window() as usize) << 4;
+            let new_end = s.remote_seq_no + s.rx_buffer.len() + advertised;
+            assert!(advertised <= s.rx_buffer.window());
+            assert!(new_end >= previous_end - 15);
+            assert!(new_end <= previous_end + 15);
+            if !queued {
+                assert!(new_end >= previous_end);
+            }
+        }
