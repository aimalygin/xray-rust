+                ..RECV_TEMPL
+            }));
+        }
+        for time in [1010, 1011, 1012] {
+            send!(s, time time, TcpRepr {
+                seq_number: REMOTE_SEQ + 1,
+                ack_number: Some(LOCAL_SEQ + 1),
+                ..SEND_TEMPL
+            });
