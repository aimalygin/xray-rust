+    #[test]
+    fn receive_budget_reduction_drains_existing_credit_without_revoking_it() {
+        for start in [REMOTE_SEQ + 1, TcpSeqNumber(i32::MAX - 32 * 1024)] {
+            let mut s = socket_established();
+            s.rx_buffer = SocketBuffer::new(vec![0; 1024 * 1024]);
+            s.remote_win_shift = 4;
+            s.remote_seq_no = start;
+            s.remote_last_ack = Some(start);
+            s.receive_window_limit = Some(128 * 1024);
+            s.remote_last_win = s.scaled_window();
+            let original_right_edge = start + 128 * 1024;
+            s.receive_window_end = Some(original_right_edge);
+            s.set_receive_window_limit(64 * 1024);
+            assert_eq!(
+                s.scaled_window(),
+                8192,
+                "outstanding advertised space must stay usable"
+            );
+            let payload = [0x6a; 4096];
+            let mut received = [0; 4096];
+            for index in 0..16 {
+                let time = Instant::from_millis(index as i64 + 1);
+                let reply = send(
+                    &mut s,
+                    time,
+                    &TcpRepr {
+                        seq_number: start + index * payload.len(),
+                        ack_number: Some(LOCAL_SEQ + 1),
+                        payload: &payload,
+                        ..SEND_TEMPL
+                    },
+                );
+                let mut advertisement =
+                    reply.map(|reply| (reply.ack_number.unwrap(), reply.window_len));
+                if advertisement.is_none() {
+                    recv(&mut s, time, |packet| {
+                        advertisement = packet
+                            .ok()
+                            .map(|reply| (reply.ack_number.unwrap(), reply.window_len));
+                    });
+                }
+                let (ack, window) =
+                    advertisement.expect("accepted data schedules an ACK for dispatch");
+                let right_edge = ack + ((window as usize) << 4);
+                assert_eq!(
+                    right_edge, original_right_edge,
+                    "old credit should drain before the smaller budget renews it"
+                );
+                assert_eq!(s.recv_slice(&mut received).unwrap(), payload.len());
+                assert_eq!(received, payload);
+            }
+            assert_eq!(
+                s.scaled_window(),
+                4096,
+                "after draining, the active flow must use its smaller budget"
+            );
+        }
+    }
