+    #[tokio::test]
+    async fn poll_data_reads_only_what_the_current_frame_needs() {
+        // DATA frames of 700 bytes in 1,150-byte chunks: frames straddle
+        // chunks, and some chunks hold a frame boundary.
+        const CHUNK: usize = 1150;
+        let mut wire = BytesMut::new();
+        let mut body = Vec::new();
+        for i in 0..64u8 {
+            let payload = vec![i; 700];
+            body.extend_from_slice(&payload);
+            Frame::Data(Bytes::from(payload)).encode_with_payload(&mut wire);
+        }
+        let mut wire = wire.freeze();
+        let mut recv = FakeRecv::default();
+        while !wire.is_empty() {
+            recv.chunk(wire.split_to(wire.len().min(CHUNK)));
+        }
+        let mut stream: FrameStream<_, ()> = FrameStream::new(BufRecvStream::new(recv));
+
+        let mut received = Vec::new();
+        loop {
+            match poll_fn(|cx| stream.poll_next(cx)).await {
+                Ok(Some(Frame::Data(_))) => {}
+                Ok(None) => break,
+                Ok(Some(_)) => panic!("expected only DATA frames"),
+                Err(_) => panic!("frame stream error"),
+            }
+            while let Some(data) = poll_fn(|cx| to_bytes(stream.poll_data(cx)))
+                .await
+                .unwrap_or_else(|_| panic!("frame stream error"))
+            {
+                received.extend_from_slice(&data);
+                assert!(stream.stream.buf().remaining() <= 2 * CHUNK);
+            }
+        }
+        assert_eq!(received, body);
+    }
