+    #[tokio::test]
+    async fn poll_next_decodes_buffered_frames_before_reading() {
+        let mut recv = FakeRecv::default();
+        for _ in 0..4 {
+            let mut chunk = BytesMut::new();
+            for _ in 0..16 {
+                Frame::headers(&b"header"[..]).encode_with_payload(&mut chunk);
+            }
+            recv.chunk(chunk.freeze());
+        }
+        let chunk_len = recv.chunks[0].len();
+        let mut stream: FrameStream<_, ()> = FrameStream::new(BufRecvStream::new(recv));
 
+        for _ in 0..64 {
+            assert_poll_matches!(|cx| stream.poll_next(cx), Ok(Some(Frame::Headers(_))));
+            assert!(stream.stream.buf().remaining() < chunk_len);
+        }
+        assert_poll_matches!(|cx| stream.poll_next(cx), Ok(None));
+    }
