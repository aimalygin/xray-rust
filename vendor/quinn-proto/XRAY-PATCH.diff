     use super::*;
 
     #[test]
+    fn advertised_datagram_cap_preserves_the_receive_queue_budget() {
+        let mut config = TransportConfig::default();
+        config.datagram_receive_buffer_size(Some(256 * 1024));
+        let advertised = |config: &TransportConfig| {
+            TransportParameters::new(
+                config,
+                &EndpointConfig::default(),
+                &crate::RandomConnectionIdGenerator::new(8),
+                ConnectionId::new(&[0; 8]),
+                None,
+                &mut rand::rng(),
+            )
+            .max_datagram_frame_size
+            .map(|size| size.into_inner())
+        };
+        assert_eq!(advertised(&config), Some(65535));
+        config.advertised_datagram_frame_size(Some(1200));
+        assert_eq!(advertised(&config), Some(1200));
+        assert_eq!(config.datagram_receive_buffer_size, Some(256 * 1024));
+        config.datagram_receive_buffer_size(Some(1000));
+        assert_eq!(advertised(&config), Some(1000));
+        config.datagram_receive_buffer_size(None);
+        assert_eq!(advertised(&config), None);
+    }
