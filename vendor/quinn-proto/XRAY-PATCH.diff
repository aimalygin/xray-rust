+        let mut recv = RecvStream {
+            id,
+            state: client,
+            pending,
+        };
+        let mut chunks = recv.read(true).unwrap();
+        while let Ok(Some(_)) = chunks.next(usize::MAX) {}
+        let _ = chunks.finalize();
+        send_credit(client, pending)
+    }
