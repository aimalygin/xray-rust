+        p.delay_with_rate(rtt, 1000, 1000, 2_000_000, Some(20_000_000), now);
+        assert_eq!(p.capacity, 80_000);
+        p.delay_with_rate(rtt, 1000, 1000, 2_000_000, Some(100_000), now);
+        assert_eq!((p.capacity, p.tokens), (10_000, 10_000));
