+#[test]
+fn measured_rtt_callback_arrives_before_batch_end() {
+    let (mut pair, client, _, _) = connected(false);
+    pair.latency = Duration::from_millis(25);
+    pair.client_conn_mut(client).ping();
+    pair.drive();
+    let controller = pair
+        .client_conn_mut(client)
+        .congestion_state()
+        .clone_box()
