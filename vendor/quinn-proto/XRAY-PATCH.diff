+    );
+    assert!(
+        recorded
+            .lock()
+            .unwrap()
+            .iter()
+            .any(|&size| size > DEFAULT_MTU as u64),
+        "ack-eliciting oversized MTU probes must be sampled even when subsequently lost"
+    );
+}
