+#[test]
+fn a_minimum_update_returns_credit_before_a_third_of_the_window() {
+    let mut flow = FlowControl::new();
+    flow.inc_window(4 << 20).unwrap();
+    flow.assign_capacity(4 << 20).unwrap();
+
+    // 64 KiB arrive and the reader releases them.
+    flow.send_data(65_536).unwrap();
+    flow.assign_capacity(65_536).unwrap();
+
+    assert_eq!(flow.unclaimed_capacity(), None);
+    assert_eq!(flow.unclaimed_capacity_at(None), None);
+    assert_eq!(flow.unclaimed_capacity_at(Some(4096)), Some(65_536));
+}
+
+#[test]
+fn a_minimum_update_holds_small_releases_while_the_window_is_open() {
+    let mut flow = FlowControl::new();
+    flow.inc_window(4 << 20).unwrap();
+    flow.assign_capacity(4 << 20).unwrap();
+
+    flow.send_data(1000).unwrap();
+    flow.assign_capacity(1000).unwrap();
+
+    assert_eq!(flow.unclaimed_capacity_at(Some(4096)), None);
+}
+
+#[test]
+fn a_minimum_update_releases_anything_that_doubles_a_nearly_closed_window() {
+    let mut flow = FlowControl::new();
+    flow.inc_window(65_535).unwrap();
+    flow.assign_capacity(65_535).unwrap();
+
+    flow.send_data(64_535).unwrap();
+    flow.assign_capacity(1000).unwrap();
+
+    assert_eq!(flow.unclaimed_capacity_at(Some(4096)), Some(1000));
+}
