+#[test]
+fn a_minimum_update_returns_credit_before_a_third_of_the_window() {
+    let mut flow = FlowControl::new();
+    flow.inc_window(4 << 20).unwrap();
+    flow.assign_capacity(4 << 20).unwrap();
+
+    // 64 KiB arrive and the reader releases them.
+    flow.send_data(65_536).unwrap();
+    flow.assign_capacity(65_536).unwrap();
+
+    assert_eq!(flow.unclaimed_capacity(), None);
+    assert_eq!(flow.unclaimed_capacity_at(None), None);
+    assert_eq!(flow.unclaimed_capacity_at(Some(4096)), Some(65_536));
+}
