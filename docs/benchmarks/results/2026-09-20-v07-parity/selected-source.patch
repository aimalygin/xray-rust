+        assert_eq!(
+            options.next(),
+            Some(DhcpOption {
+                kind: field::OPT_PARAMETER_REQUEST_LIST,
+                data: &[1, 3, 6, 42]
+            })
+        );
+        assert_eq!(options.next(), None);
+    }
