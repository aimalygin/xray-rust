+        bbr.cwnd = 64 * 1024;
+        bbr.acked_bytes = bbr.init_cwnd;
+        assert!(bbr.get_target_cwnd(bbr.cwnd_gain) < bbr.cwnd);
+        let before = bbr.cwnd;
+        bbr.calculate_cwnd(1200, 0);
