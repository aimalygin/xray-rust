+    #[test]
+    fn test_out_of_order_overflow_still_replies_with_duplicate_ack() {
+        let count = crate::config::ASSEMBLER_MAX_SEGMENT_COUNT;
+        let mut s = socket_established_with_buffer_sizes(64, count * 4 + 64);
+        s.remote_has_sack = true;
+        for n in 0..count {
+            let repr = TcpRepr {
+                seq_number: REMOTE_SEQ + 1 + 2 * n + 1,
+                ack_number: Some(LOCAL_SEQ + 1),
+                payload: b"a",
+                ..SEND_TEMPL
+            };
+            assert!(send(&mut s, Instant::ZERO, &repr).is_some());
+        }
+        let before: Vec<_> = s.assembler.iter_data().collect();
+        let repr = TcpRepr {
+            seq_number: REMOTE_SEQ + 1 + 2 * count + 1,
+            ack_number: Some(LOCAL_SEQ + 1),
+            payload: b"b",
+            ..SEND_TEMPL
+        };
+        let reply = send(&mut s, Instant::ZERO, &repr)
+            .expect("even discarded out-of-order data must trigger loss feedback");
+        assert_eq!(reply.ack_number, Some(REMOTE_SEQ + 1));
+        assert_eq!(s.assembler.iter_data().collect::<Vec<_>>(), before);
+        for (left, right) in reply.sack_ranges.into_iter().flatten() {
+            assert!(before.iter().any(|&(a, b)| {
+                left == (REMOTE_SEQ + 1 + a).0 as u32 && right == (REMOTE_SEQ + 1 + b).0 as u32
+            }));
+        }
+    }
