@@ -0,0 +1,175 @@
+#[cfg(not(test))]
+#[cfg(feature = "log")]
+#[collapse_debuginfo(yes)]
+macro_rules! net_log {
+    (trace, $($arg:expr),*) => { log::trace!($($arg),*) };
+    (debug, $($arg:expr),*) => { log::debug!($($arg),*) };
+}
+
+#[cfg(test)]
+#[cfg(feature = "log")]
