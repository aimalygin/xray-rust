+        assert!(s.assembler.is_empty());
+        put(&mut s, 15, b"pqrs");
+        assert_eq!(s.rx_buffer.get_allocated(0, 4).as_ptr(), base);
+        let mut read = [0; 4];
+        assert_eq!(s.recv_slice(&mut read).unwrap(), 4);
+        assert_eq!(&read, b"pqrs");
