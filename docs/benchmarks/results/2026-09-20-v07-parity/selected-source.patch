+    #[test]
+    fn test_established_recv_reuses_empty_storage() {
+        let mut s = socket_established_with_buffer_sizes(64, 64);
+        let mut first = None;
+        for offset in (0..192).step_by(6) {
+            let payload = [offset as u8; 6];
+            send(
+                &mut s,
+                Instant::ZERO,
+                &TcpRepr {
+                    seq_number: REMOTE_SEQ + 1 + offset,
+                    ack_number: Some(LOCAL_SEQ + 1),
+                    payload: &payload,
+                    ..SEND_TEMPL
+                },
+            );
+            let received = s.rx_buffer.get_allocated(0, 6);
+            let base = *first.get_or_insert(received.as_ptr());
+            assert_eq!(received.as_ptr(), base, "empty RX storage moved");
+            assert_eq!(received, payload);
+            let mut read = [0; 6];
+            assert_eq!(s.recv_slice(&mut read).unwrap(), 6);
+            assert_eq!(read, payload);
+            assert!(s.rx_buffer.is_empty());
+            assert_eq!(s.rx_buffer.capacity(), 64);
+            assert_eq!(s.remote_seq_no, REMOTE_SEQ + 1 + offset + 6);
+            assert_eq!(s.scaled_window(), 64);
+            recv(&mut s, Instant::ZERO, |reply| {
+                let reply = reply.unwrap();
+                assert_eq!(reply.ack_number, Some(REMOTE_SEQ + 1 + offset + 6));
+                assert_eq!(reply.window_len, 64);
+            });
+        }
+    }
