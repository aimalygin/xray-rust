+
+/// Measurement-only: samples how many pages of every live endpoint receive
+/// buffer are resident, via mincore(2). Enabled by XRAY_EXP_RESIDENCY_LOG=<path>.
+mod exp_residency {
+    use std::io::Write;
+    use std::sync::Mutex;
+    use std::time::{Duration, Instant};
+
+    struct Live {
+        addr: usize,
+        len: usize,
+        segments: usize,
+        batch: usize,
+        id: u64,
+        peak: usize,
+    }
+
+    static LIVE: Mutex<Vec<Live>> = Mutex::new(Vec::new());
+    static NEXT: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+    static STARTED: std::sync::Once = std::sync::Once::new();
+
+    pub(super) fn register(addr: usize, len: usize, segments: usize, batch: usize) {
+        let Some(path) = std::env::var_os("XRAY_EXP_RESIDENCY_LOG") else {
+            return;
+        };
+        let id = NEXT.fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+        LIVE.lock().unwrap().push(Live { addr, len, segments, batch, id, peak: 0 });
+        STARTED.call_once(|| {
+            std::thread::spawn(move || sampler(path));
+        });
+    }
+
+    pub(super) fn unregister(addr: usize) {
+        if std::env::var_os("XRAY_EXP_RESIDENCY_LOG").is_none() {
+            return;
+        }
+        let mut live = LIVE.lock().unwrap();
+        if let Some(index) = live.iter().position(|entry| entry.addr == addr) {
+            let entry = live.swap_remove(index);
+            let (pages, resident, slots) = measure(&entry);
+            eprintln!(
+                "exp_residency drop id={} len={} segments={} pages={} resident={} slots_touched={} peak={}",
+                entry.id, entry.len, entry.segments, pages, resident, slots, entry.peak.max(resident)
+            );
+        }
+    }
+
+    fn measure(entry: &Live) -> (usize, usize, usize) {
+        let page = 4096usize;
+        let start = entry.addr & !(page - 1);
+        let end = (entry.addr + entry.len + page - 1) & !(page - 1);
+        let pages = (end - start) / page;
+        let mut vec = vec![0u8; pages];
+        // SAFETY: the range covers a live allocation registered above; the LIVE
+        // lock is held by the caller, and RecvState unregisters before freeing.
+        let rc = unsafe { libc::mincore(start as *mut libc::c_void, end - start, vec.as_mut_ptr()) };
+        if rc != 0 {
+            return (pages, usize::MAX, 0);
+        }
+        let resident = vec.iter().filter(|b| **b & 1 != 0).count();
+        // slots: the endpoint chunks its buffer into BATCH_SIZE equal slots.
+        let slot_len = entry.len / entry.batch;
+        let mut slots = 0;
+        for slot in 0..entry.batch {
+            let a = entry.addr + slot * slot_len;
+            let first = (a - start) / page;
+            if vec.get(first).is_some_and(|b| *b & 1 != 0) {
+                slots += 1;
             }
         }
+        (pages, resident, slots)
     }
+
+    fn sampler(path: std::ffi::OsString) {
+        let mut file = std::fs::OpenOptions::new().create(true).append(true).open(&path).unwrap();
+        let started = Instant::now();
+        let mut peak_sum = 0usize;
+        loop {
+            std::thread::sleep(Duration::from_millis(200));
+            let mut live = LIVE.lock().unwrap();
+            let mut sum = 0usize;
+            let mut virt = 0usize;
+            let mut rows = Vec::with_capacity(live.len());
+            for entry in live.iter_mut() {
+                let (pages, resident, slots) = measure(entry);
+                entry.peak = entry.peak.max(resident);
+                sum += resident;
+                virt += pages;
+                rows.push(format!("{}:{}:{}", entry.id, resident, slots));
+            }
+            let count = live.len();
+            drop(live);
+            peak_sum = peak_sum.max(sum);
+            let _ = writeln!(
+                file,
+                "t_ms={} buffers={} virt_pages={} resident_pages={} peak_resident_pages={} per_buffer(id:resident:slots)={}",
+                started.elapsed().as_millis(),
+                count,
+                virt,
+                sum,
+                peak_sum,
+                rows.join(",")
+            );
+        }
+    }
 }
 
