index 0000000..cd71121
--- /dev/null
+++ b/vendor/quinn-proto/src/xray_exp.rs
@@ -0,0 +1,53 @@
+#![allow(missing_docs)]
+//! Experiment-only memory counters; never committed.
+use std::cell::Cell;
+use std::sync::atomic::{AtomicI64, AtomicU64, AtomicUsize};
+
+pub const TAG_RECV_DATAGRAM: u8 = 1;
+pub const TAG_DEFRAG: u8 = 2;
+pub const TAG_H3_BATCH: u8 = 3;
+pub const TAG_RECV_BUF: u8 = 4;
+pub const TAG_RELAY: u8 = 5;
+pub const TAG_UPLOAD: u8 = 6;
+pub const TAGS: usize = 8;
+
+thread_local! {
+    static TAG: Cell<u8> = const { Cell::new(0) };
+    static OWNER: Cell<u16> = const { Cell::new(u16::MAX) };
+}
+
+pub fn current_owner() -> u16 {
+    OWNER.try_with(|owner| owner.get()).unwrap_or(u16::MAX)
+}
+
+pub fn with_owner<R>(owner: u16, f: impl FnOnce() -> R) -> R {
+    let previous = OWNER.try_with(|current| current.replace(owner)).unwrap_or(u16::MAX);
+    let result = f();
+    let _ = OWNER.try_with(|current| current.set(previous));
+    result
+}
+
+pub fn current_tag() -> u8 {
+    TAG.try_with(|tag| tag.get()).unwrap_or(0)
+}
+
+pub fn with_tag<R>(tag: u8, f: impl FnOnce() -> R) -> R {
+    let previous = TAG.try_with(|current| current.replace(tag)).unwrap_or(0);
+    let result = f();
+    let _ = TAG.try_with(|current| current.set(previous));
+    result
+}
+
+pub static ASSEMBLER_BUFFERED: AtomicI64 = AtomicI64::new(0);
+pub static ASSEMBLER_ALLOCATED: AtomicI64 = AtomicI64::new(0);
+pub static ASSEMBLER_CHUNKS: AtomicI64 = AtomicI64::new(0);
+pub static DEFRAGMENTS: AtomicU64 = AtomicU64::new(0);
+pub static CHANNEL_BYTES: AtomicI64 = AtomicI64::new(0);
+pub static CHANNEL_EVENTS: AtomicI64 = AtomicI64::new(0);
+pub static CONNECTIONS: AtomicI64 = AtomicI64::new(0);
+
+pub const SLOTS: usize = 512;
+pub static CONN_BUFFERED: [AtomicU64; SLOTS] = [const { AtomicU64::new(0) }; SLOTS];
+pub static CONN_CHANNEL: [AtomicI64; SLOTS] = [const { AtomicI64::new(0) }; SLOTS];
+pub static CONN_WINDOW: [AtomicU64; SLOTS] = [const { AtomicU64::new(0) }; SLOTS];
+pub static NEXT_SLOT: AtomicUsize = AtomicUsize::new(0);
