diff --git a/crates/xray-transport/src/xray_exp_mem.rs b/crates/xray-transport/src/xray_exp_mem.rs
new file mode 100644
index 0000000..ea9ef77
--- /dev/null
+++ b/crates/xray-transport/src/xray_exp_mem.rs
@@ -0,0 +1,428 @@
+//! Experiment-only tagging allocator and memory sampler; never committed.
+//!
+//! Every allocation carries a header whose last byte names the site that was
+//! tagged when it was made (`quinn::xray_exp::with_tag`). A sampler thread
+//! started by the first XHTTP H3 connection writes, every 50 ms, the process
+//! RSS, glibc's `mallinfo2`, the live bytes per tag and quinn's receive-side
+//! counters to `$XRAY_EXP_MEMLOG`, and dumps `malloc_info` and smaps whenever
+//! RSS grows 2 MiB past the last dump.
+use std::alloc::{GlobalAlloc, Layout, System};
+use std::io::Write;
+use std::sync::atomic::{AtomicI64, AtomicU64, Ordering::Relaxed};
+use std::sync::Once;
+use std::time::{Duration, Instant};
+
+use quinn::xray_exp as qx;
+pub use quinn::xray_exp::{with_tag, TAG_RELAY};
+
+const HEADER: usize = 16;
+
+pub struct TagAlloc;
+
+static LIVE: [AtomicI64; qx::TAGS] = [const { AtomicI64::new(0) }; qx::TAGS];
+static LIVE_COUNT: [AtomicI64; qx::TAGS] = [const { AtomicI64::new(0) }; qx::TAGS];
+static ALLOCS: AtomicU64 = AtomicU64::new(0);
+
+#[global_allocator]
+static GLOBAL: TagAlloc = TagAlloc;
+
+// Registry of live received-datagram allocations, so the sampler can take a
+// census of their ages, owners and contents. Header layout (16 bytes before
+// the pointer): u32 registry index, u32 allocation time in ms, u32 size,
+// u16 owner slot, one spare byte, the tag.
+const REGISTRY_SLOTS: usize = 1 << 20;
+static REGISTRY: std::sync::atomic::AtomicPtr<std::sync::atomic::AtomicUsize> =
+    std::sync::atomic::AtomicPtr::new(std::ptr::null_mut());
+static REGISTRY_CURSOR: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+static EPOCH: std::sync::OnceLock<Instant> = std::sync::OnceLock::new();
+static CENSUS: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+fn registry() -> &'static [std::sync::atomic::AtomicUsize] {
+    let mut table = REGISTRY.load(std::sync::atomic::Ordering::Acquire);
+    if table.is_null() {
+        let layout = Layout::array::<std::sync::atomic::AtomicUsize>(REGISTRY_SLOTS).unwrap();
+        let fresh = unsafe { System.alloc_zeroed(layout) }.cast::<std::sync::atomic::AtomicUsize>();
+        match REGISTRY.compare_exchange(
+            std::ptr::null_mut(),
+            fresh,
+            std::sync::atomic::Ordering::AcqRel,
+            std::sync::atomic::Ordering::Acquire,
+        ) {
+            Ok(_) => table = fresh,
+            Err(existing) => {
+                unsafe { System.dealloc(fresh.cast(), layout) };
+                table = existing;
+            }
+        }
+    }
+    unsafe { std::slice::from_raw_parts(table, REGISTRY_SLOTS) }
+}
+
+fn now_ms() -> u32 {
+    EPOCH.get_or_init(Instant::now).elapsed().as_millis() as u32
+}
+
+unsafe fn register(ptr: *mut u8, size: usize) {
+    let table = registry();
+    let mut index = u32::MAX;
+    for _ in 0..64 {
+        let candidate = REGISTRY_CURSOR.fetch_add(1, Relaxed) & (REGISTRY_SLOTS - 1);
+        if table[candidate]
+            .compare_exchange(0, ptr as usize, Relaxed, Relaxed)
+            .is_ok()
+        {
+            index = candidate as u32;
+            break;
+        }
+    }
+    unsafe {
+        ptr.sub(16).cast::<u32>().write(index);
+        ptr.sub(12).cast::<u32>().write(now_ms());
+        ptr.sub(8).cast::<u32>().write(size as u32);
+        ptr.sub(4).cast::<u16>().write(qx::current_owner());
+    }
+}
+
+unsafe fn unregister(ptr: *mut u8) {
+    let index = unsafe { ptr.sub(16).cast::<u32>().read() };
+    if index != u32::MAX {
+        registry()[index as usize].store(0, Relaxed);
+    }
+}
+
+#[inline]
+fn header(layout: &Layout) -> usize {
+    layout.align().max(HEADER)
+}
+
+unsafe impl GlobalAlloc for TagAlloc {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        let header = header(&layout);
+        let base = unsafe {
+            System.alloc(Layout::from_size_align_unchecked(layout.size() + header, header))
+        };
+        if base.is_null() {
+            return base;
+        }
+        let tag = qx::current_tag();
+        let ptr = unsafe { base.add(header) };
+        unsafe { *ptr.sub(1) = tag };
+        if tag == qx::TAG_RECV_DATAGRAM && header == HEADER {
+            if CENSUS.load(Relaxed) {
+                unsafe { register(ptr, layout.size()) };
+            } else {
+                unsafe { ptr.sub(16).cast::<u32>().write(u32::MAX) };
+            }
+        }
+        LIVE[tag as usize].fetch_add(layout.size() as i64, Relaxed);
+        LIVE_COUNT[tag as usize].fetch_add(1, Relaxed);
+        ALLOCS.fetch_add(1, Relaxed);
+        ptr
+    }
+
+    unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
+        let header = header(&layout);
+        let base = unsafe {
+            System.alloc_zeroed(Layout::from_size_align_unchecked(layout.size() + header, header))
+        };
+        if base.is_null() {
+            return base;
+        }
+        let tag = qx::current_tag();
+        let ptr = unsafe { base.add(header) };
+        unsafe { *ptr.sub(1) = tag };
+        if tag == qx::TAG_RECV_DATAGRAM && header == HEADER {
+            if CENSUS.load(Relaxed) {
+                unsafe { register(ptr, layout.size()) };
+            } else {
+                unsafe { ptr.sub(16).cast::<u32>().write(u32::MAX) };
+            }
+        }
+        LIVE[tag as usize].fetch_add(layout.size() as i64, Relaxed);
+        LIVE_COUNT[tag as usize].fetch_add(1, Relaxed);
+        ALLOCS.fetch_add(1, Relaxed);
+        ptr
+    }
+
+    unsafe fn dealloc(&self, ptr: *mut u8, layout: Layout) {
+        let header = header(&layout);
+        let tag = unsafe { *ptr.sub(1) } as usize % qx::TAGS;
+        if tag == qx::TAG_RECV_DATAGRAM as usize && header == HEADER {
+            unsafe { unregister(ptr) };
+        }
+        LIVE[tag].fetch_sub(layout.size() as i64, Relaxed);
+        LIVE_COUNT[tag].fetch_sub(1, Relaxed);
+        unsafe {
+            System.dealloc(
+                ptr.sub(header),
+                Layout::from_size_align_unchecked(layout.size() + header, header),
+            )
+        }
+    }
+
+    unsafe fn realloc(&self, ptr: *mut u8, layout: Layout, new_size: usize) -> *mut u8 {
+        let header = header(&layout);
+        let tag = unsafe { *ptr.sub(1) } as usize % qx::TAGS;
+        if tag == qx::TAG_RECV_DATAGRAM as usize && header == HEADER {
+            unsafe { unregister(ptr) };
+        }
+        let base = unsafe {
+            System.realloc(
+                ptr.sub(header),
+                Layout::from_size_align_unchecked(layout.size() + header, header),
+                new_size + header,
+            )
+        };
+        if base.is_null() {
+            return base;
+        }
+        LIVE[tag].fetch_add(new_size as i64 - layout.size() as i64, Relaxed);
+        let ptr = unsafe { base.add(header) };
+        if tag == qx::TAG_RECV_DATAGRAM as usize && header == HEADER {
+            if CENSUS.load(Relaxed) {
+                unsafe { register(ptr, new_size) };
+            } else {
+                unsafe { ptr.sub(16).cast::<u32>().write(u32::MAX) };
+            }
+        }
+        ptr
+    }
+}
+
+static START: Once = Once::new();
+
+pub fn start_sampler() {
+    START.call_once(|| {
+        CENSUS.store(std::env::var_os("XRAY_EXP_CENSUS").is_some(), Relaxed);
+        if let Some(path) = std::env::var_os("XRAY_EXP_MEMLOG") {
+            let path = path.to_string_lossy().into_owned();
+            let _ = std::thread::Builder::new()
+                .name("xray-exp-mem".into())
+                .spawn(move || sample_loop(&path));
+        }
+    });
+}
+
+fn status_kib() -> (u64, u64, u64) {
+    let mut values = (0, 0, 0);
+    if let Ok(text) = std::fs::read_to_string("/proc/self/status") {
+        for line in text.lines() {
+            let mut parts = line.split_whitespace();
+            let key = parts.next().unwrap_or("");
+            let value: u64 = parts.next().and_then(|v| v.parse().ok()).unwrap_or(0);
+            match key {
+                "VmRSS:" => values.0 = value,
+                "RssAnon:" => values.1 = value,
+                "RssFile:" => values.2 = value,
+                _ => {}
+            }
+        }
+    }
+    values
+}
+
+#[cfg(all(target_os = "linux", target_env = "gnu"))]
+fn mallinfo() -> [u64; 6] {
+    let info = unsafe { libc::mallinfo2() };
+    [
+        info.arena as u64,
+        info.hblkhd as u64,
+        info.uordblks as u64,
+        info.fordblks as u64,
+        info.keepcost as u64,
+        info.ordblks as u64,
+    ]
+}
+
+#[cfg(not(all(target_os = "linux", target_env = "gnu")))]
+fn mallinfo() -> [u64; 6] {
+    [0; 6]
+}
+
+#[cfg(all(target_os = "linux", target_env = "gnu"))]
+fn dump_malloc_info(path: &str) {
+    let Ok(path) = std::ffi::CString::new(path) else {
+        return;
+    };
+    unsafe {
+        let file = libc::fopen(path.as_ptr(), c"w".as_ptr());
+        if !file.is_null() {
+            libc::malloc_info(0, file);
+            libc::fclose(file);
+        }
+    }
+}
+
+#[cfg(not(all(target_os = "linux", target_env = "gnu")))]
+fn dump_malloc_info(_path: &str) {}
+
+fn sample_loop(path: &str) {
+    let Ok(mut out) = std::fs::File::create(path) else {
+        return;
+    };
+    let start = Instant::now();
+    let mut dumped_rss = 0_u64;
+    let mut dumps = 0_u32;
+    let mut last_census = 0_u128;
+    let mut census_rss = 0_u64;
+    loop {
+        let (rss, anon, file) = status_kib();
+        let mi = mallinfo();
+        let live: Vec<i64> = LIVE.iter().map(|v| v.load(Relaxed)).collect();
+        let counts: Vec<i64> = LIVE_COUNT.iter().map(|v| v.load(Relaxed)).collect();
+        let total: i64 = live.iter().sum();
+        let mut buffered: Vec<u64> = qx::CONN_BUFFERED
+            .iter()
+            .map(|v| v.load(Relaxed))
+            .filter(|&v| v > 0)
+            .collect();
+        buffered.sort_unstable();
+        let channel: Vec<i64> = qx::CONN_CHANNEL
+            .iter()
+            .map(|v| v.load(Relaxed))
+            .filter(|&v| v > 0)
+            .collect();
+        let at_least = |limit: u64| buffered.iter().filter(|&&v| v >= limit).count();
+        let line = format!(
+            "t_ms={} rss={} anon={} file={} arena={} hblkhd={} uord={} ford={} keep={} ordblks={} \
+             live_total={} live_other={} live_recv={} live_defrag={} live_h3={} live_recvbuf={} \
+             live_relay={} live_upload={} n_recv={} n_other={} allocs={} asm_buf={} asm_alloc={} \
+             asm_chunks={} defrags={} chan_bytes={} chan_events={} conns={} buf_conns={} \
+             buf_max={} buf_p50={} buf_ge512k={} buf_ge1m={} buf_ge1_5m={} buf_ge1_9m={} \
+             chan_conns={} chan_max={} h3_bytes={} h3_chunks={} h3_max_chunks={}",
+            start.elapsed().as_millis(),
+            rss,
+            anon,
+            file,
+            mi[0],
+            mi[1],
+            mi[2],
+            mi[3],
+            mi[4],
+            mi[5],
+            total,
+            live[0],
+            live[qx::TAG_RECV_DATAGRAM as usize],
+            live[qx::TAG_DEFRAG as usize],
+            live[qx::TAG_H3_BATCH as usize],
+            live[qx::TAG_RECV_BUF as usize],
+            live[qx::TAG_RELAY as usize],
+            live[qx::TAG_UPLOAD as usize],
+            counts[qx::TAG_RECV_DATAGRAM as usize],
+            counts[0],
+            ALLOCS.load(Relaxed),
+            qx::ASSEMBLER_BUFFERED.load(Relaxed),
+            qx::ASSEMBLER_ALLOCATED.load(Relaxed),
+            qx::ASSEMBLER_CHUNKS.load(Relaxed),
+            qx::DEFRAGMENTS.load(Relaxed),
+            qx::CHANNEL_BYTES.load(Relaxed),
+            qx::CHANNEL_EVENTS.load(Relaxed),
+            qx::CONNECTIONS.load(Relaxed),
+            buffered.len(),
+            buffered.last().copied().unwrap_or(0),
+            buffered.get(buffered.len() / 2).copied().unwrap_or(0),
+            at_least(512 * 1024),
+            at_least(1024 * 1024),
+            at_least(1536 * 1024),
+            at_least(1946 * 1024),
+            channel.len(),
+            channel.iter().max().copied().unwrap_or(0),
+            h3::XRAY_EXP_BUFLIST_BYTES.load(Relaxed),
+            h3::XRAY_EXP_BUFLIST_CHUNKS.load(Relaxed),
+            h3::XRAY_EXP_BUFLIST_MAX_CHUNKS.load(Relaxed),
+        );
+        let _ = writeln!(out, "{line}");
+        if rss > dumped_rss + 2048 && dumps < 200 {
+            dumped_rss = rss;
+            dumps += 1;
+            dump_malloc_info(&format!("{path}.peak-malloc-info.xml"));
+            if let Ok(smaps) = std::fs::read_to_string("/proc/self/smaps") {
+                let _ = std::fs::write(format!("{path}.peak-smaps"), smaps);
+            }
+            let _ = std::fs::write(format!("{path}.peak-line"), &line);
+        }
+        if CENSUS.load(Relaxed) && start.elapsed().as_millis() / 1000 != last_census {
+            last_census = start.elapsed().as_millis() / 1000;
+            census(path, &format!("{path}.census-oldest"));
+        }
+        if CENSUS.load(Relaxed) && rss > census_rss + 4096 {
+            census_rss = rss;
+            census(path, &format!("{path}.peak-oldest"));
+        }
+        std::thread::sleep(Duration::from_millis(50));
+    }
+}
+
+fn census(path: &str, oldest_path: &str) {
+    let table = registry();
+    let now = now_ms();
+    let mut per_owner = std::collections::BTreeMap::<u16, (u64, u64, u64)>::new();
+    let mut ages = [0_u64; 6];
+    let mut oldest: Vec<(u32, u16, u32, usize)> = Vec::new();
+    let mut live = 0_u64;
+    let mut count = 0_u64;
+    for entry in table {
+        let ptr = entry.load(Relaxed) as *mut u8;
+        if ptr.is_null() {
+            continue;
+        }
+        let (time, size, owner) = unsafe {
+            (
+                ptr.sub(12).cast::<u32>().read(),
+                ptr.sub(8).cast::<u32>().read(),
+                ptr.sub(4).cast::<u16>().read(),
+            )
+        };
+        let age = now.saturating_sub(time);
+        live += u64::from(size);
+        count += 1;
+        let row = per_owner.entry(owner).or_default();
+        row.0 += u64::from(size);
+        row.1 += 1;
+        if age >= 1000 {
+            row.2 += u64::from(size);
+        }
+        let bucket = match age {
+            0..100 => 0,
+            100..300 => 1,
+            300..1000 => 2,
+            1000..3000 => 3,
+            3000..10000 => 4,
+            _ => 5,
+        };
+        ages[bucket] += u64::from(size);
+        oldest.push((time, owner, size, ptr as usize));
+    }
+    oldest.sort_unstable();
+    let owners: Vec<String> = per_owner
+        .iter()
+        .map(|(owner, (bytes, n, old))| {
+            let buffered = qx::CONN_BUFFERED
+                .get(usize::from(*owner))
+                .map_or(0, |v| v.load(Relaxed));
+            format!("{owner}:{bytes}:{n}:{old}:{buffered}")
+        })
+        .collect();
+    if let Ok(mut out) = std::fs::OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open(format!("{path}.census"))
+    {
+        let _ = writeln!(
+            out,
+            "t_ms={now} live={live} n={count} age_lt100ms={} age_lt300ms={} age_lt1s={} age_lt3s={} age_lt10s={} age_ge10s={} owners={}",
+            ages[0], ages[1], ages[2], ages[3], ages[4], ages[5], owners.join(",")
+        );
+    }
+    let mut dump = String::new();
+    for (time, owner, size, ptr) in oldest.iter().take(40) {
+        let shown = (*size as usize).min(160);
+        let bytes = unsafe { std::slice::from_raw_parts(*ptr as *const u8, shown) };
+        let hex: String = bytes.iter().map(|b| format!("{b:02x}")).collect();
+        dump.push_str(&format!(
+            "age_ms={} owner={owner} size={size} hex={hex}\n",
+            now.saturating_sub(*time)
+        ));
+    }
+    let _ = std::fs::write(oldest_path, dump);
+}
