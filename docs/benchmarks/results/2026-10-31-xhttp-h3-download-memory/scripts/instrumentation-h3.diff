 use std::io::IoSlice;
 
 use bytes::{Buf, Bytes};
+use std::sync::atomic::{AtomicI64, Ordering::Relaxed};
 
+/// Experiment: bytes held by every `BufList`.
+pub static XRAY_EXP_BUFLIST_BYTES: AtomicI64 = AtomicI64::new(0);
+/// Experiment: chunks held by every `BufList`.
+pub static XRAY_EXP_BUFLIST_CHUNKS: AtomicI64 = AtomicI64::new(0);
+/// Experiment: largest chunk count one `BufList` reached.
+pub static XRAY_EXP_BUFLIST_MAX_CHUNKS: AtomicI64 = AtomicI64::new(0);
+
 #[derive(Debug)]
 pub(crate) struct BufList<T> {
     bufs: VecDeque<T>,
+    exp_bytes: usize,
 }
 
+impl<T> BufList<T> {
+    fn exp_add(&mut self, bytes: usize) {
+        self.exp_bytes += bytes;
+        XRAY_EXP_BUFLIST_BYTES.fetch_add(bytes as i64, Relaxed);
+        XRAY_EXP_BUFLIST_CHUNKS.fetch_add(1, Relaxed);
+        XRAY_EXP_BUFLIST_MAX_CHUNKS.fetch_max(self.bufs.len() as i64 + 1, Relaxed);
+    }
+
+    fn exp_sub(&mut self, bytes: usize, chunks: usize) {
+        self.exp_bytes -= bytes;
+        XRAY_EXP_BUFLIST_BYTES.fetch_sub(bytes as i64, Relaxed);
+        XRAY_EXP_BUFLIST_CHUNKS.fetch_sub(chunks as i64, Relaxed);
+    }
+}
+
+impl<T> Drop for BufList<T> {
+    fn drop(&mut self) {
+        XRAY_EXP_BUFLIST_BYTES.fetch_sub(self.exp_bytes as i64, Relaxed);
+        XRAY_EXP_BUFLIST_CHUNKS.fetch_sub(self.bufs.len() as i64, Relaxed);
+    }
+}
+
 impl<T: Buf> BufList<T> {
     pub(crate) fn new() -> BufList<T> {
         BufList {
             bufs: VecDeque::new(),
+            exp_bytes: 0,
         }
     }
 
