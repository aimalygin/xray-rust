+/// Diagnostic SOCKS relay with independently owned codec states and tasks.
+/// JoinSet aborts children if the owner is externally dropped; normal close,
+/// error and timeout paths also join them before reporting completion.
+pub(crate) async fn copy_parallel_with_idle_timeout<R, W>(
+    inbound: (R, W),
+    outbound: (xray_transport::ParallelRead, xray_transport::ParallelWrite),
+    idle: Duration,
+    buffer_size: usize,
+    traffic: std::sync::Arc<ConnectionTraffic>,
+    close: impl std::future::Future<Output = ()>,
+) -> io::Result<(u64, u64)>
+where
+    R: AsyncRead + Unpin + Send + 'static,
+    W: AsyncWrite + Unpin + Send + 'static,
+{
+    let (mut a_read, mut a_write) = inbound;
+    let (mut b_read, mut b_write) = outbound;
+    let activity = std::sync::Arc::new(IdleActivity::new());
+    let down_activity = activity.clone();
+    let mut tasks = tokio::task::JoinSet::new();
+    let up_traffic = traffic.clone();
+    let up_activity = activity.clone();
+    tasks.spawn(async move {
+        // Sniffed initial payload may already be owned by the codec. The
+        // independent reader cannot flush it; do so before waiting for input.
+        if let Err(error) = b_write.flush().await {
+            return (true, Err(error));
+        }
+        (
+            true,
+            copy_direction_with_counter(
+                &mut a_read,
+                &mut b_write,
+                up_activity,
+                buffer_size,
+                Some(&up_traffic.uplink_bytes),
+            )
+            .await,
+        )
+    });
+    tasks.spawn(async move {
+        (
+            false,
+            copy_direction_with_counter(
+                &mut b_read,
+                &mut a_write,
+                down_activity,
+                buffer_size,
+                Some(&traffic.downlink_bytes),
+            )
+            .await,
+        )
+    });
+    let deadline = tokio::time::sleep(idle);
+    tokio::pin!(deadline, close);
+    let mut totals = (0, 0);
+    let outcome = loop {
+        tokio::select! {
+            result = tasks.join_next() => match result {
+                Some(Ok((up, Ok(n)))) => {
+                    if up { totals.0 = n; } else { totals.1 = n; }
+                    if tasks.is_empty() { break Ok(totals); }
+                }
+                Some(Ok((_, Err(e)))) => break Err(e),
+                Some(Err(e)) => break Err(io::Error::other(e)),
+                None => break Ok(totals),
+            },
+            () = &mut deadline => {
+                let expires = activity.last() + idle;
+                if expires <= tokio::time::Instant::now() {
+                    break Err(io::Error::new(io::ErrorKind::TimedOut, "connection idle timeout"));
+                }
+                deadline.as_mut().reset(expires);
+            },
+            () = &mut close => break Err(io::ErrorKind::Interrupted.into()),
+        }
+    };
+    tasks.abort_all();
+    while tasks.join_next().await.is_some() {}
+    outcome
+}
