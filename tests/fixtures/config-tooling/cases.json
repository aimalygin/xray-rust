{
  "schemaVersion": 1,
  "cases": [
    {
      "name": "loopback-policy",
      "config": {
        "inbounds": [
          {
            "listen": "127.0.0.1",
            "port": 1080,
            "protocol": "socks",
            "settings": {
              "auth": "noauth",
              "udp": true,
              "accounts": [],
              "ip": "127.0.0.1",
              "userLevel": 0,
              "allowUnauthenticatedLan": false
            },
            "tag": "socks-in",
            "sniffing": {
              "enabled": true,
              "destOverride": [
                "http",
                "tls",
                "quic"
              ],
              "metadataOnly": false,
              "routeOnly": true,
              "domainsExcluded": [],
              "excludedDomains": []
            }
          },
          {
            "tag": "http-in",
            "protocol": "http",
            "port": 1081,
            "settings": {
              "accounts": [],
              "allowTransparent": false,
              "userLevel": 0
            }
          },
          {
            "tag": "tun-in",
            "protocol": "tun"
          }
        ],
        "outbounds": [
          {
            "protocol": "freedom",
            "tag": "direct",
            "settings": {},
            "mux": {
              "enabled": false,
              "concurrency": 8
            }
          }
        ],
        "policy": {
          "levels": {
            "0": {
              "handshake": 4,
              "connIdle": 300,
              "uplinkOnly": 2,
              "downlinkOnly": 5,
              "bufferSize": 16,
              "statsUserUplink": false,
              "statsUserDownlink": false
            }
          },
          "system": {
            "statsInboundUplink": false,
            "statsInboundDownlink": false,
            "statsOutboundUplink": false,
            "statsOutboundDownlink": false
          }
        },
        "observatory": {
          "subjectSelector": [
            "direct"
          ],
          "probeURL": "https://probe.example/generate_204",
          "probeInterval": "10s",
          "enableConcurrency": false
        }
      },
      "accepted": true,
      "objects": {
        "ROOT": "",
        "INBOUND": "/inbounds/0",
        "SNIFFING": "/inbounds/0/sniffing",
        "SOCKS_SETTINGS": "/inbounds/0/settings",
        "HTTP_SETTINGS": "/inbounds/1/settings",
        "OUTBOUND": "/outbounds/0",
        "FREEDOM_SETTINGS": "/outbounds/0/settings",
        "MUX": "/outbounds/0/mux",
        "POLICY": "/policy",
        "POLICY_LEVEL": "/policy/levels/0",
        "POLICY_SYSTEM": "/policy/system",
        "OBSERVATORY": "/observatory"
      }
    },
    {
      "name": "dns-policy",
      "config": {
        "dns": {
          "hosts": {
            "service.example": "192.0.2.80"
          },
          "queryStrategy": "UseIPv4",
          "servers": [
            {
              "address": "192.0.2.53",
              "port": 53,
              "domains": [
                "domain:example"
              ],
              "expectIPs": [
                "192.0.2.0/24"
              ],
              "unexpectedIPs": [],
              "tag": "upstream",
              "timeoutMs": 2000,
              "skipFallback": false,
              "queryStrategy": "UseIPv4",
              "finalQuery": false
            }
          ],
          "fakeIp": {
            "enabled": true,
            "ipv4Pool": "198.18.0.0/15",
            "poolSize": 128,
            "ttl": 60
          }
        },
        "inbounds": [
          {
            "listen": "127.0.0.1",
            "port": 1080,
            "protocol": "socks",
            "settings": {
              "auth": "noauth",
              "udp": true
            },
            "tag": "socks-in"
          }
        ],
        "outbounds": [
          {
            "protocol": "freedom",
            "tag": "direct"
          },
          {
            "protocol": "dns",
            "settings": {
              "rewriteAddress": "192.0.2.53",
              "rewriteNetwork": "tcp",
              "rewritePort": 53,
              "rules": [
                {
                  "action": "return",
                  "qType": "64-65",
                  "rCode": 3
                }
              ]
            },
            "tag": "dns-out"
          }
        ],
        "routing": {
          "domainStrategy": "IPOnDemand",
          "rules": [
            {
              "network": "udp,tcp",
              "outboundTag": "dns-out",
              "port": 53,
              "type": "field"
            },
            {
              "ip": [
                "192.0.2.0/24"
              ],
              "outboundTag": "direct",
              "type": "field"
            }
          ]
        }
      },
      "accepted": true,
      "objects": {
        "DNS": "/dns",
        "DNS_SERVER": "/dns/servers/0",
        "FAKE_IP": "/dns/fakeIp",
        "DNS_OUTBOUND": "/outbounds/1/settings",
        "DNS_RULE": "/outbounds/1/settings/rules/0",
        "ROUTING": "/routing",
        "ROUTING_RULE": "/routing/rules/0"
      }
    },
    {
      "name": "balancer",
      "config": {
        "inbounds": [
          {
            "listen": "127.0.0.1",
            "port": 1080,
            "protocol": "socks",
            "settings": {
              "auth": "noauth",
              "udp": true
            },
            "tag": "socks-in"
          }
        ],
        "outbounds": [
          {
            "protocol": "freedom",
            "tag": "direct"
          }
        ],
        "routing": {
          "domainStrategy": "IPIfNonMatch",
          "balancers": [
            {
              "tag": "select",
              "selector": [
                "direct"
              ],
              "fallbackTag": "direct",
              "strategy": {
                "type": "leastLoad",
                "settings": {
                  "expected": 1,
                  "maxRTT": "1s",
                  "tolerance": 0.1,
                  "baselines": [
                    "100ms"
                  ],
                  "costs": [
                    {
                      "regexp": false,
                      "match": "direct",
                      "value": 1.0
                    }
                  ]
                }
              }
            }
          ],
          "rules": [
            {
              "type": "field",
              "domain": [
                "domain:example"
              ],
              "balancerTag": "select"
            }
          ]
        }
      },
      "accepted": true,
      "objects": {
        "BALANCER": "/routing/balancers/0",
        "BALANCER_STRATEGY": "/routing/balancers/0/strategy",
        "LEAST_LOAD": "/routing/balancers/0/strategy/settings",
        "LEAST_LOAD_COST": "/routing/balancers/0/strategy/settings/costs/0"
      }
    },
